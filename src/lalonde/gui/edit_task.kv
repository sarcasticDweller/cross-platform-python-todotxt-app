<DateField>:
    text: f"{root.label_text}: {root.value_text if root.value_text else 'Tap to Set'}"
    on_release: root.show_date_picker(root.field_name)

<DescriptionField>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    MDTextField:
        id: description_input
        hint_text: "Description"
        helper_text: "Describe the task"
        multiline: True
        mode: "rectangle"

<EditTaskScreen>:
    name: "edit_task_screen"
    task_manager: app.task_manager
    BoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "Edit Task" if root.mode == "edit" else "Create Task"
            pos_hint: {"top": 1}
            on_kv_post: self.action_button.elevation = 0
            left_action_items: [["arrow-left", lambda x: root.on_back()]]
            right_action_items: [["delete-forever", lambda x: root.on_delete()], ["content-save", lambda x: root.on_save()]]

        MDScrollView:
            MDList:
                id: edit_task_options_container
