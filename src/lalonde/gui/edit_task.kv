<DateField>:
    size_hint_y: None
    text: f"{root.label_text}: {root.value_text if root.value_text else 'Tap to Set'}"
    on_release: root.show_picker(root.field_name)
    IconLeftWidget:
        icon: root.icon

<TimeField>:
    size_hint_y: None
    text: f"{root.label_text}: {root.value_text if root.value_text else 'Tap to Set'}"
    on_release: root.show_picker(root.field_name)
    IconLeftWidget:
        icon: root.icon


<DescriptionField>:
    size_hint_y: None
    height: description_input.height
    MDTextField:
        icon_left: "text-box-edit-outline"
        pos_hint: {"x": 0.033, "top": 1} # placeholder for now, does not look good on all display sizes
        id: description_input
        hint_text: "Description"
        #helper_text: "Describe the task"
        multiline: True
        mode: "line"

<EditTaskScreen>:
    name: "edit_task_screen"
    task_manager: app.task_manager
    BoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "Edit Task" if root.mode == "edit" else "Create Task"
            pos_hint: {"top": 1}
            on_kv_post: self.action_button.elevation = 0
            left_action_items: [["arrow-left", lambda x: root.back()]]
            right_action_items: [["delete-forever", lambda x: root.delete()], ["content-save", lambda x: root.save()]]

        MDScrollView:
            MDList:
                id: edit_task_options_container
