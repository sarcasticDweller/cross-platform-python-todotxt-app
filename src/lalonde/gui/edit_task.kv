<DateField>:
    orientation: "horizontal"
    Label:
        text: root.field_name
    Button:
        text: root.name_text if root.name_text else "(tap to set)"
        on_release: root.screen.show_date_picker(root.field_name)

<EditTaskScreen>:
    name: "edit_task_screen"
    task_manager: app.task_manager
    BoxLayout:
        orientation: "vertical"
        ActionBar:
            ActionView:
                ActionPrevious:
                    with_previous: True
                    on_release: root.on_back()
                ActionButton:
                    text: "Delete"
                    on_release: root.on_delete()
                    disabled: root.mode == "create"
                    opacity: 0 if root.mode == "create" else 1
                ActionButton:
                    text: "Save"
                    on_release: root.on_save()
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                #size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "description"
                TextInput:
                    id: description
                    multiline: True
                    text: root.description
                    on_text: root.description = self.text

                Label:
                    text: "is_completed"
                CheckBox:
                    id: is_completed
                    size: dp(48), dp(48)
                    active: root.is_completed
                    on_active: root.is_completed = self.active

                BoxLayout:
                    orientation: "horizontal"
                    Label:
                        text: "priority"
                    Spinner:
                        id: priority
                        text: root.priority if root.priority else ""
                        values: [""] + [chr(c) for c in range (65, 91)] # drop to 70 if too long
                        on_text: root.priority = self.text

                DateField:
                    field_name: "completion_date"
                    screen: root

                DateField:
                    field_name: "creation_date"
                    screen: root

                Label:
                    text: "project_tags"
                TextInput:
                    id: project_tags
                    multiline: False
                    text: root.project_tags
                    on_text: root.project_tags = self.text

                Label:
                    text: "context_tags"
                TextInput:
                    id: context_tags
                    multiline: False
                    text: root.context_tags
                    on_text: root.context_tags = self.text

                DateField:
                    field_name: "due"
                    screen: root

                Label:
                    text: "rec"
                TextInput:
                    id: rec
                    multiline: False
                    text: root.rec
                    on_text: root.rec = self.text

                MDRaisedButton:
                    text: "Save"
                    on_release: root.on_save()
